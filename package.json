{
  "name": "formsaver",
  "version": "1.0.0",
  "description": "A Chrome extension to save form data based on URL for later retrieval",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "copy-manifest": "node scripts/copy-files.js manifest.json dist/manifest.json",
    "zip": "npm run build && npm run copy-manifest && rimraf formsaver-extension.zip && jszip-cli add dist/* -o formsaver-extension.zip",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "format:check": "prettier --check src/**/*.{ts,js,json}",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@types/chrome": "0.0.268",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "typescript": "5.5.3",
    "typescript-eslint": "8.22.0"
  },
  "private": true
}
