{
  "name": "formsaver",
  "version": "1.0.0",
  "description": "A Chrome extension to save form data based on URL for later retrieval",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node build.js",
    "build": "node build.js --prod",
    "build:idea": "cross-env NODE_ENV=production rollup -c --bundleConfigAsCjs",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,vue}",
    "lint:fix": "eslint src/**/*.{ts,vue} --fix",
    "format": "prettier --write src/**/*.{ts,js,json,vue}",
    "format:check": "prettier --check src/**/*.{ts,js,json,vue}",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "cross-env": "^10.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "5.2.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3",
    "rollup": "^4.28.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "typescript": "5.5.3",
    "typescript-eslint": "8.22.0"
  },
  "private": true,
  "dependencies": {
    "vue": "^3.5.28"
  }
}
